<Window x:Class="DBsync.Tray.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:DBsync.Tray.Icons"
        xmlns:views="clr-namespace:DBsync.Tray.Views"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" ResizeMode="NoResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

  <!--
    Settings. The same 520px card and title bar as the wizard.

    Only what belongs to the person: sign-in launch, appearance, and where the data lives. Anything
    that belongs to one folder pair stays on the pair (#9), so this window does not grow into a
    second place to configure the same thing.
  -->

  <Window.Resources>
    <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>

  <Grid x:Name="Root" Width="520" Margin="24" RenderTransformOrigin="0.5,1">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="RiseTransform" Y="10" />
    </Grid.RenderTransform>

    <Border CornerRadius="{DynamicResource RadiusLg}"
            Background="{DynamicResource BackgroundBrush}"
            Effect="{DynamicResource ShadowLgEffect}" />

    <Border CornerRadius="{DynamicResource RadiusLg}" ClipToBounds="True"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource EdgeLgBrush}" BorderThickness="1">
      <StackPanel>

        <Border Style="{StaticResource WindowTitleBarStyle}" MouseLeftButtonDown="OnTitleBarDrag">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <icons:Icon Grid.Column="0" Key="GearSix" Size="16"
                        Foreground="{DynamicResource AccentBrush}" Margin="0,0,8.4,0" />
            <TextBlock Grid.Column="1" Text="DBsync — Settings"
                       Style="{StaticResource WindowTitleTextStyle}" />
            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="OnClose" ToolTip="Close">
              <icons:Icon Key="X" Size="14" />
            </Button>
          </Grid>
        </Border>

        <StackPanel Margin="22.4,16.8,22.4,22.4">

          <!-- ── Startup ───────────────────────────────────────────────── -->
          <TextBlock Text="Startup" Style="{StaticResource FieldLabelTextStyle}" />
          <CheckBox Style="{StaticResource CheckBoxStyle}" Margin="0,4,0,0"
                    IsChecked="{Binding StartWithWindows}"
                    Content="Start DBsync when I sign in" />
          <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,16.8"
                     Text="Only affects this window. Syncing is done by a Windows service that runs whether or not anyone is signed in." />

          <!-- ── Appearance ────────────────────────────────────────────── -->
          <TextBlock Text="Appearance" Style="{StaticResource FieldLabelTextStyle}" />
          <Grid Margin="0,4,0,16.8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                       Style="{StaticResource SecondaryTextStyle}"
                       Text="{Binding Shell.AppearanceSubline}" />

            <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
              <StackPanel Orientation="Horizontal">
                <RadioButton GroupName="SettingsAppearance" Style="{StaticResource SegmentOptionStyle}"
                             IsChecked="{Binding Shell.IsLightSelected, Mode=OneWay}"
                             Command="{Binding Shell.SetLightCommand}" ToolTip="Light">
                  <icons:Icon Key="Sun" Size="14" Foreground="{Binding Foreground,
                              RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                </RadioButton>
                <Border Style="{StaticResource SegmentSeparatorStyle}" />
                <RadioButton GroupName="SettingsAppearance" Style="{StaticResource SegmentOptionStyle}"
                             IsChecked="{Binding Shell.IsDarkSelected, Mode=OneWay}"
                             Command="{Binding Shell.SetDarkCommand}" ToolTip="Dark">
                  <icons:Icon Key="Moon" Size="14" Foreground="{Binding Foreground,
                              RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                </RadioButton>
                <Border Style="{StaticResource SegmentSeparatorStyle}" />
                <RadioButton GroupName="SettingsAppearance" Style="{StaticResource SegmentOptionStyle}"
                             IsChecked="{Binding Shell.IsMatchWindowsSelected, Mode=OneWay}"
                             Command="{Binding Shell.SetMatchWindowsCommand}" ToolTip="Match Windows">
                  <icons:Icon Key="DesktopTower" Size="14" Foreground="{Binding Foreground,
                              RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                </RadioButton>
              </StackPanel>
            </Border>
          </Grid>

          <!-- ── Service ───────────────────────────────────────────────── -->
          <TextBlock Text="Sync service" Style="{StaticResource FieldLabelTextStyle}" />
          <Border Style="{StaticResource SurfacePanelStyle}" Margin="0,4,0,0">
            <StackPanel>
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Status" Width="86"
                           Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding ServiceState}"
                           Style="{StaticResource DialogBodyStyle}" />
              </Grid>
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Runs as" Width="86"
                           Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding ServiceAccount}" TextWrapping="Wrap"
                           Style="{StaticResource DialogBodyStyle}" />
              </Grid>
              <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                         Text="This is the account a share sees when a folder pair has no sign-in of its own." />
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Margin="0,16.8,0,0"
                      Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <icons:Icon Key="X" Size="14" Margin="0,1,6,0" VerticalAlignment="Top"
                        Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="{Binding Error}" Style="{StaticResource ValidationLineStyle}" MaxWidth="430" />
          </StackPanel>

          <Grid Margin="0,16.8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" HorizontalAlignment="Left"
                    Style="{StaticResource GhostButtonStyle}"
                    Content="Open data folder" Command="{Binding OpenDataFolderCommand}" />
            <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                    Content="Done" Click="OnClose" IsDefault="True" />
          </Grid>

        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
