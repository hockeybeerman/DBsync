<Window x:Class="DBsync.Tray.Views.RemovePairDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:DBsync.Tray.Icons"
        xmlns:views="clr-namespace:DBsync.Tray.Views"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" ResizeMode="NoResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

  <!--
    Remove-pair confirmation. Same 520px card as the other dialogs.

    Cancel is the primary, default button and Remove is the secondary one - the reverse of every
    other dialog here. The palette has one accent and no destructive red, so rather than inventing
    a colour outside the design, the safe choice is the emphasised one and Enter backs out.
  -->

  <Window.Resources>
    <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>

  <Grid x:Name="Root" Width="520" Margin="24" RenderTransformOrigin="0.5,1">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="RiseTransform" Y="10" />
    </Grid.RenderTransform>

    <Border CornerRadius="{DynamicResource RadiusLg}"
            Background="{DynamicResource SurfaceBrush}"
            Effect="{DynamicResource ShadowLgEffect}" />

    <Border CornerRadius="{DynamicResource RadiusLg}"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource EdgeLgBrush}" BorderThickness="1"
            Padding="11.2">
      <StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8.4">
          <icons:Icon Key="Trash" Size="17" Margin="0,0,5.6,0"
                      Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Text="Remove this folder pair?" Style="{StaticResource DialogTitleStyle}" />
        </StackPanel>

        <TextBlock Style="{StaticResource DialogBodyStyle}" Margin="0,0,0,11.2">
          <Run Text="{Binding PairName, Mode=OneWay}" FontWeight="Medium" />
          <Run Text="will stop syncing." />
        </TextBlock>

        <Border Style="{StaticResource SurfacePanelStyle}"
                Background="{DynamicResource BackgroundBrush}" Margin="0,0,0,11.2">
          <StackPanel>
            <TextBlock Text="This pair" Style="{StaticResource FieldLabelTextStyle}" />
            <TextBlock Style="{StaticResource DialogBodyStyle}" TextWrapping="Wrap">
              <Run Text="{Binding LocalPath, Mode=OneWay}"
                   FontFamily="{DynamicResource MonoFontFamily}" FontSize="13" />
            </TextBlock>
            <TextBlock Style="{StaticResource DialogBodyStyle}" TextWrapping="Wrap">
              <Run Text="{Binding SharePath, Mode=OneWay}"
                   FontFamily="{DynamicResource MonoFontFamily}" FontSize="13" />
            </TextBlock>
          </StackPanel>
        </Border>

        <!--
          Spelled out because "remove" reads as "delete my files" to anyone who has not read the
          source. Each line is what the service actually does on DeletePair.
        -->
        <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                   Text="No files are deleted, from this PC or from the share — both folders are left exactly as they are." />
        <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="Its activity history is kept. Saved credentials and the record of what was already in sync are discarded, so adding it back later starts with a fresh comparison." />

        <StackPanel Orientation="Horizontal" Margin="0,8.4,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
          <icons:Icon Key="X" Size="14" Margin="0,1,6,0" VerticalAlignment="Top"
                      Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Text="{Binding Error}" Style="{StaticResource ValidationLineStyle}" MaxWidth="430" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,11.2,0,0">
          <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,5.6,0"
                  Content="Remove pair" Command="{Binding RemoveCommand}" />
          <Button Style="{StaticResource PrimaryButtonStyle}" Content="Cancel"
                  Click="OnCancel" IsDefault="True" />
        </StackPanel>

      </StackPanel>
    </Border>
  </Grid>
</Window>
