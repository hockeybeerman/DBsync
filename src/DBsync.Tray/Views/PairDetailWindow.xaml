<Window x:Class="DBsync.Tray.Views.PairDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:DBsync.Tray.Icons"
        xmlns:views="clr-namespace:DBsync.Tray.Views"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" ResizeMode="NoResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

  <!--
    One folder pair: what it is doing, and everything you can do to it. The design calls for a row
    click to "open that pair's detail/settings" but never draws it - see #9.

    This window owns no settings. Edit opens the wizard in edit mode, Remove opens the
    confirmation from #15, History opens the activity window filtered to this pair. What is shown
    read-only below is a summary of those settings, so the window explains the pair without
    becoming a second place to change it.
  -->

  <Window.Resources>
    <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>

  <Grid x:Name="Root" Width="520" Margin="24" RenderTransformOrigin="0.5,1">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="RiseTransform" Y="10" />
    </Grid.RenderTransform>

    <Border CornerRadius="{DynamicResource RadiusLg}"
            Background="{DynamicResource BackgroundBrush}"
            Effect="{DynamicResource ShadowLgEffect}" />

    <Border CornerRadius="{DynamicResource RadiusLg}" ClipToBounds="True"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource EdgeLgBrush}" BorderThickness="1">
      <StackPanel>

        <Border Style="{StaticResource WindowTitleBarStyle}" MouseLeftButtonDown="OnTitleBarDrag">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <icons:Icon Grid.Column="0" Key="{Binding StatusIcon}" Size="16"
                        Foreground="{DynamicResource AccentBrush}" Margin="0,0,8.4,0" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource WindowTitleTextStyle}" />
            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="OnClose" ToolTip="Close">
              <icons:Icon Key="X" Size="14" />
            </Button>
          </Grid>
        </Border>

        <StackPanel Margin="22.4,16.8,22.4,22.4">

          <!-- ── What it is doing ──────────────────────────────────────── -->
          <Grid Margin="0,0,0,11.2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Detail}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Style="{StaticResource DialogBodyStyle}" />
            <ContentControl Grid.Column="1" Content="{Binding StatusTag}"
                            Style="{StaticResource PairTagStyle}" VerticalAlignment="Center" />
          </Grid>

          <Border Style="{StaticResource SurfacePanelStyle}" Margin="0,0,0,11.2">
            <StackPanel>
              <TextBlock Text="{Binding LocalPath}" TextWrapping="Wrap"
                         FontFamily="{DynamicResource MonoFontFamily}" FontSize="12.5"
                         Foreground="{DynamicResource TextBrush}" />
              <icons:Icon Key="ArrowsLeftRight" Size="13" HorizontalAlignment="Left" Margin="0,3,0,3"
                          Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{Binding SharePath}" TextWrapping="Wrap"
                         FontFamily="{DynamicResource MonoFontFamily}" FontSize="12.5"
                         Foreground="{DynamicResource TextBrush}" />
            </StackPanel>
          </Border>

          <!-- Conflicts, when there are any: the one thing here that needs a person. -->
          <Border Style="{StaticResource SurfacePanelStyle}" Margin="0,0,0,11.2"
                  BorderBrush="{DynamicResource EdgeConflictBrush}" BorderThickness="0,0,0,0"
                  Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <icons:Icon Key="WarningDiamond" Size="15" Margin="0,1,8.4,0" VerticalAlignment="Top"
                          Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{Binding ConflictText}" TextWrapping="Wrap" MaxWidth="400"
                         Style="{StaticResource DialogBodyStyle}" />
            </StackPanel>
          </Border>

          <!-- ── Last 7 days ───────────────────────────────────────────── -->
          <TextBlock Text="Last 7 days" Style="{StaticResource FieldLabelTextStyle}" />
          <TextBlock Text="{Binding SummaryText}" Margin="0,3,0,16.8"
                     Style="{StaticResource DialogBodyStyle}" />

          <!-- ── Settings, read-only ───────────────────────────────────── -->
          <TextBlock Text="Sync options" Style="{StaticResource FieldLabelTextStyle}" />
          <StackPanel Margin="0,4,0,16.8">
            <TextBlock Text="{Binding DirectionText}" Style="{StaticResource SecondaryTextStyle}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding WatcherText}" Style="{StaticResource SecondaryTextStyle}"
                       TextWrapping="Wrap" Margin="0,2,0,0" />
            <TextBlock Text="{Binding VersionsText}" Style="{StaticResource SecondaryTextStyle}"
                       TextWrapping="Wrap" Margin="0,2,0,0" />
            <TextBlock Text="{Binding LimitText}" Style="{StaticResource SecondaryTextStyle}"
                       TextWrapping="Wrap" Margin="0,2,0,0" />
            <TextBlock Text="{Binding ExcludesText}" Style="{StaticResource SecondaryTextStyle}"
                       TextWrapping="Wrap" Margin="0,2,0,0" />
          </StackPanel>

          <!-- ── Pause, which is this pair's own and not the global one ── -->
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding PauseHint}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,11.2,0"
                       Style="{StaticResource SecondaryTextStyle}" />
            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding TogglePauseCommand}">
              <StackPanel Orientation="Horizontal">
                <icons:Icon Key="{Binding PauseIcon}" Size="13" Margin="0,0,5.6,0"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <TextBlock Text="{Binding PauseLabel}" />
              </StackPanel>
            </Button>
          </Grid>

          <StackPanel Orientation="Horizontal" Margin="0,11.2,0,0"
                      Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <icons:Icon Key="X" Size="14" Margin="0,1,6,0" VerticalAlignment="Top"
                        Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="{Binding Error}" Style="{StaticResource ValidationLineStyle}" MaxWidth="430" />
          </StackPanel>

          <!-- ── Actions ───────────────────────────────────────────────── -->
          <Grid Margin="0,16.8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource GhostButtonStyle}"
                    Content="Remove pair…" Click="OnRemove" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,5.6,0"
                      Content="History" Click="OnHistory" />
              <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,5.6,0"
                      Content="Sync now" Command="{Binding SyncNowCommand}" />
              <Button Style="{StaticResource PrimaryButtonStyle}"
                      Content="Edit…" Click="OnEdit" IsDefault="True" />
            </StackPanel>
          </Grid>

        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
