<Window x:Class="DBsync.Tray.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:DBsync.Tray.Icons"
        xmlns:views="clr-namespace:DBsync.Tray.Views"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

  <!--
    The tray flyout. 384px panel anchored bottom-right, 16px from the right edge and 16px above
    the taskbar (positioning is in the code-behind, against the work area).

    AllowsTransparency is what buys the rounded corners and the drop shadow; it costs hardware
    acceleration on the window, which at this size is not worth worrying about.
  -->

  <Window.Resources>
    <views:FractionToStarConverter x:Key="FractionToStar" />
    <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>

  <!--
    Margin leaves room for the drop shadow to paint outside the panel. The shadow is on its own
    layer behind the content rather than on the content border: an Effect forces its whole visual
    subtree through an intermediate surface, which softens text.
  -->
  <Grid x:Name="Root" Width="384" Margin="24" RenderTransformOrigin="0.5,1">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="RiseTransform" Y="10" />
    </Grid.RenderTransform>

    <Border CornerRadius="{DynamicResource RadiusLg}"
            Background="{DynamicResource BackgroundBrush}"
            Effect="{DynamicResource ShadowLgEffect}" />

    <Border CornerRadius="{DynamicResource RadiusLg}" ClipToBounds="True"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource EdgeLgBrush}" BorderThickness="1">
      <StackPanel>

        <!-- ── Header ──────────────────────────────────────────────────── -->
        <Grid Margin="11.2,11.2,11.2,8.4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Rotates while any pair is syncing; static when paused or idle. -->
          <icons:Icon x:Name="BrandGlyph" Grid.Column="0" Key="ShuffleSimple"
                      Size="{DynamicResource HeaderGlyphSize}"
                      Foreground="{DynamicResource AccentBrush}"
                      VerticalAlignment="Center" Margin="0,0,8.4,0"
                      RenderTransformOrigin="0.5,0.5">
            <icons:Icon.RenderTransform>
              <RotateTransform x:Name="BrandRotation" />
            </icons:Icon.RenderTransform>
          </icons:Icon>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="DBsync" FontFamily="{DynamicResource HeadingFontFamily}"
                       FontWeight="{DynamicResource HeadingFontWeight}" FontSize="15" />
            <TextBlock Text="{Binding StatusLine}" Style="{StaticResource StatusLineStyle}" />
          </StackPanel>

          <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Margin="0,0,8.4,0"
                  ToolTip="Activity — arrives with issue #4" Click="OnActivity">
            <icons:Icon Key="ClockCounterClockwise" Size="{DynamicResource HeaderButtonGlyphSize}" />
          </Button>
          <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}"
                  ToolTip="Settings — not yet designed" Click="OnSettings">
            <icons:Icon Key="GearSix" Size="{DynamicResource HeaderButtonGlyphSize}" />
          </Button>
        </Grid>

        <!-- ── Pair list ───────────────────────────────────────────────── -->
        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasPairs, Converter={StaticResource BoolToVisibility}}">
          <ItemsControl ItemsSource="{Binding Pairs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource PairRowStyle}" Click="OnPairRow">
                  <StackPanel>

                    <!-- Line 1: status glyph, name, tag -->
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <icons:Icon Grid.Column="0" Key="{Binding StatusIcon}"
                                  Size="{DynamicResource PairIconSize}"
                                  Style="{StaticResource PairStatusIconStyle}"
                                  Margin="0,0,5.6,0" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <ContentControl Grid.Column="2" Content="{Binding StatusTag}"
                                      Style="{StaticResource PairTagStyle}" />
                    </Grid>

                    <!-- Line 2: local ⇄ share, monospace, truncated -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                      <TextBlock Text="{Binding LocalPath}" Style="{StaticResource PathTextStyle}"
                                 MaxWidth="{DynamicResource LocalPathMaxWidth}" />
                      <icons:Icon Key="ArrowsLeftRight" Size="{DynamicResource PathArrowSize}"
                                  Foreground="{DynamicResource TextMuted55Brush}" Margin="6,0,6,0" />
                      <TextBlock Text="{Binding SharePath}" Style="{StaticResource PathTextStyle}"
                                 MaxWidth="{DynamicResource SharePathMaxWidth}" />
                    </StackPanel>

                    <!-- Line 3: the service's own detail copy -->
                    <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextMuted62Brush}"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Line 4: progress, syncing only -->
                    <Grid Height="3" Margin="0,6,0,0" ClipToBounds="True"
                          Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}">
                      <Border Background="{DynamicResource ProgressTrackBrush}"
                              CornerRadius="{DynamicResource RadiusProgress}" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="{Binding ProgressFraction, Converter={StaticResource FractionToStar}}" />
                          <ColumnDefinition Width="{Binding ProgressFraction, Converter={StaticResource FractionToStar}, ConverterParameter=remainder}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource AccentBrush}"
                                CornerRadius="{DynamicResource RadiusProgress}" />
                      </Grid>
                      <!--
                        The sweep's brush is declared inline so each row animates its own copy;
                        a shared resource brush would have every row driving the same transform.
                      -->
                      <Rectangle Style="{StaticResource ProgressSweepStyle}">
                        <Rectangle.Fill>
                          <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,0">
                            <GradientStop Offset="0" Color="{DynamicResource ProgressSweepEdgeColor}" />
                            <GradientStop Offset="0.5" Color="{DynamicResource ProgressSweepCoreColor}" />
                            <GradientStop Offset="1" Color="{DynamicResource ProgressSweepEdgeColor}" />
                            <LinearGradientBrush.RelativeTransform>
                              <TranslateTransform />
                            </LinearGradientBrush.RelativeTransform>
                          </LinearGradientBrush>
                        </Rectangle.Fill>
                      </Rectangle>
                    </Grid>

                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- Empty state. Not in the design, which never shows a pairless flyout; #8 replaces it. -->
        <TextBlock Margin="16,4,16,12" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMuted55Brush}"
                   Text="{Binding EmptyStateText}"
                   Visibility="{Binding HasPairs, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

        <!-- ── Appearance ──────────────────────────────────────────────── -->
        <Grid Margin="11.2,8.4,11.2,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="Appearance" FontSize="13" />
            <TextBlock Text="{Binding AppearanceSubline}" FontSize="11" Margin="0,1,0,0"
                       Foreground="{DynamicResource TextMuted55Brush}" />
          </StackPanel>

          <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
            <StackPanel Orientation="Horizontal">
              <RadioButton GroupName="Appearance" Style="{StaticResource SegmentOptionStyle}"
                           IsChecked="{Binding IsLightSelected, Mode=OneWay}"
                           Command="{Binding SetLightCommand}" ToolTip="Light">
                <icons:Icon Key="Sun" Size="14" Foreground="{Binding Foreground,
                            RelativeSource={RelativeSource AncestorType=RadioButton}}" />
              </RadioButton>
              <Border Style="{StaticResource SegmentSeparatorStyle}" />
              <RadioButton GroupName="Appearance" Style="{StaticResource SegmentOptionStyle}"
                           IsChecked="{Binding IsDarkSelected, Mode=OneWay}"
                           Command="{Binding SetDarkCommand}" ToolTip="Dark">
                <icons:Icon Key="Moon" Size="14" Foreground="{Binding Foreground,
                            RelativeSource={RelativeSource AncestorType=RadioButton}}" />
              </RadioButton>
              <Border Style="{StaticResource SegmentSeparatorStyle}" />
              <RadioButton GroupName="Appearance" Style="{StaticResource SegmentOptionStyle}"
                           IsChecked="{Binding IsMatchWindowsSelected, Mode=OneWay}"
                           Command="{Binding SetMatchWindowsCommand}" ToolTip="Match Windows">
                <icons:Icon Key="DesktopTower" Size="14" Foreground="{Binding Foreground,
                            RelativeSource={RelativeSource AncestorType=RadioButton}}" />
              </RadioButton>
            </StackPanel>
          </Border>
        </Grid>

        <!-- ── Footer ──────────────────────────────────────────────────── -->
        <Grid Margin="11.2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Button Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,5.6,0"
                  ToolTip="Add folder pair — the wizard arrives with issue #3" Click="OnAddPair">
            <StackPanel Orientation="Horizontal">
              <icons:Icon Key="Plus" Size="14" Margin="0,0,6,0"
                          Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="Add folder pair" />
            </StackPanel>
          </Button>

          <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding TogglePauseCommand}">
            <StackPanel Orientation="Horizontal">
              <icons:Icon Key="{Binding PauseButtonIcon}" Size="14" Margin="0,0,6,0" />
              <TextBlock Text="{Binding PauseButtonLabel}" />
            </StackPanel>
          </Button>

          <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}"
                  HorizontalAlignment="Right"
                  ToolTip="Activity — arrives with issue #4" Click="OnActivity"
                  Content="Activity" />
        </Grid>

      </StackPanel>
    </Border>
  </Grid>
</Window>
