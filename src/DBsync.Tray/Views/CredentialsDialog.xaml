<Window x:Class="DBsync.Tray.Views.CredentialsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:DBsync.Tray.Icons"
        xmlns:views="clr-namespace:DBsync.Tray.Views"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" ResizeMode="NoResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

  <!--
    Credential re-prompt. Same 520px card and credential panel as the wizard's step 2, so signing
    in again looks like the place the credentials were first entered.
  -->

  <Window.Resources>
    <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>

  <Grid x:Name="Root" Width="520" Margin="24" RenderTransformOrigin="0.5,1">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="RiseTransform" Y="10" />
    </Grid.RenderTransform>

    <Border CornerRadius="{DynamicResource RadiusLg}"
            Background="{DynamicResource SurfaceBrush}"
            Effect="{DynamicResource ShadowLgEffect}" />

    <Border CornerRadius="{DynamicResource RadiusLg}"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource EdgeLgBrush}" BorderThickness="1"
            Padding="11.2">
      <StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8.4">
          <icons:Icon Key="LockSimple" Size="17" Margin="0,0,5.6,0"
                      Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Text="Sign in to the share" Style="{StaticResource DialogTitleStyle}" />
        </StackPanel>

        <TextBlock Style="{StaticResource DialogBodyStyle}" Margin="0,0,0,11.2">
          <Run Text="The saved credentials for" />
          <Run Text="{Binding PairName, Mode=OneWay}" FontWeight="Medium" />
          <Run Text="were rejected by" />
          <Run Text="{Binding SharePath, Mode=OneWay}"
               FontFamily="{DynamicResource MonoFontFamily}" FontSize="13" />
          <Run Text="— nothing is syncing for this pair until it can sign in." />
        </TextBlock>

        <Border Style="{StaticResource SurfacePanelStyle}"
                Background="{DynamicResource BackgroundBrush}" Margin="0,0,0,11.2">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,4.2,0">
              <TextBlock Text="Username" Style="{StaticResource FieldLabelTextStyle}" />
              <TextBox Style="{StaticResource InputStyle}"
                       Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="4.2,0,0,0">
              <TextBlock Text="Password" Style="{StaticResource FieldLabelTextStyle}" />
              <!-- Pushed across by hand; a PasswordBox deliberately has no bindable Password. -->
              <PasswordBox x:Name="PasswordField" Style="{StaticResource PasswordInputStyle}"
                           PasswordChanged="OnPasswordChanged" />
            </StackPanel>
          </Grid>
        </Border>

        <TextBlock Text="Stored in Windows Credential Manager, never in DBsync's own config."
                   Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Margin="0,8.4,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
          <icons:Icon Key="X" Size="14" Margin="0,1,6,0" VerticalAlignment="Top"
                      Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Text="{Binding Error}" Style="{StaticResource ValidationLineStyle}" MaxWidth="430" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,11.2,0,0">
          <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,5.6,0"
                  Content="Cancel" Click="OnCancel" />
          <Button Style="{StaticResource PrimaryButtonStyle}" Content="Sign in"
                  Command="{Binding SignInCommand}" IsDefault="True" />
        </StackPanel>

      </StackPanel>
    </Border>
  </Grid>
</Window>
