<Window x:Class="DBsync.Tray.Views.ActivityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:DBsync.Tray.Icons"
        xmlns:views="clr-namespace:DBsync.Tray.Views"
        Width="808" Height="620" MinWidth="640" MinHeight="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" ResizeMode="CanResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

  <!-- Activity & history. 760px panel plus the shadow margin; resizable, unlike the wizard. -->

  <Window.Resources>
    <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>

  <Grid x:Name="Root" Margin="24">
    <Border CornerRadius="{DynamicResource RadiusLg}"
            Background="{DynamicResource BackgroundBrush}"
            Effect="{DynamicResource ShadowLgEffect}" />

    <Border CornerRadius="{DynamicResource RadiusLg}" ClipToBounds="True"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource EdgeLgBrush}" BorderThickness="1">
      <DockPanel>

        <!-- ── Title bar ───────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Style="{StaticResource WindowTitleBarStyle}"
                MouseLeftButtonDown="OnTitleBarDrag">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <icons:Icon Grid.Column="0" Key="ListMagnifyingGlass" Size="16"
                        Foreground="{DynamicResource AccentBrush}" Margin="0,0,8.4,0" />
            <TextBlock Grid.Column="1" Text="DBsync — Activity"
                       Style="{StaticResource WindowTitleTextStyle}" />
            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="OnMinimise"
                    ToolTip="Minimise">
              <icons:Icon Key="Minus" Size="14" />
            </Button>
            <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Click="OnClose"
                    ToolTip="Close">
              <icons:Icon Key="X" Size="14" />
            </Button>
          </Grid>
        </Border>

        <!-- ── Footer ──────────────────────────────────────────────────── -->
        <Grid DockPanel.Dock="Bottom" Margin="22.4,16.8,22.4,22.4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,5.6,0"
                  Command="{Binding ExportCommand}" ToolTip="CSV export arrives with issue #7">
            <StackPanel Orientation="Horizontal">
              <icons:Icon Key="Export" Size="14" Margin="0,0,6,0" />
              <TextBlock Text="Export log" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}"
                  Content="Review conflicts" Command="{Binding ReviewConflictsCommand}"
                  ToolTip="The conflict dialog arrives with issue #5" />
          <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                     Style="{StaticResource SecondaryTextStyle}" Text="Loading…"
                     Visibility="{Binding Loading, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- ── Body ────────────────────────────────────────────────────── -->
        <Grid Margin="22.4,16.8,22.4,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Header: title, subline, and the three counters -->
          <Grid Grid.Row="0" Margin="0,0,0,16.8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
              <TextBlock Text="Activity &amp; history" Style="{StaticResource H4TextStyle}"
                         Margin="0,0,0,4" />
              <TextBlock Text="{Binding Subline}" Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
              <ContentControl Content="{Binding SentTag}" Style="{StaticResource TagNeutralStyle}"
                              Margin="0,0,5.6,0" />
              <ContentControl Content="{Binding ReceivedTag}" Style="{StaticResource TagNeutralStyle}"
                              Margin="0,0,5.6,0" />
              <ContentControl Content="{Binding ConflictsTag}" Style="{StaticResource TagOutlineStyle}" />
            </StackPanel>
          </Grid>

          <!--
            Filters. Not in the mock, which shows a fixed 24-hour view; the issue asks for them,
            and the counters beside the title are scoped to whatever is selected here.
          -->
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,11.2">
            <ComboBox Style="{StaticResource FilterComboBoxStyle}" Margin="0,0,5.6,0"
                      ItemsSource="{Binding PairOptions}" SelectedItem="{Binding PairFilter}"
                      DisplayMemberPath="Label" />
            <ComboBox Style="{StaticResource FilterComboBoxStyle}" MinWidth="130" Margin="0,0,5.6,0"
                      ItemsSource="{Binding KindOptions}" SelectedItem="{Binding KindFilter}"
                      DisplayMemberPath="Label" />
            <!--
              Search runs against the service, not the rows on screen - see ActivityViewModel.
              Placed with the other filters because that is what it is.
            -->
            <Grid Width="200" Margin="0,0,5.6,0">
              <TextBox Style="{StaticResource InputStyle}" VerticalContentAlignment="Center"
                       Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=0}" />
              <TextBlock Text="Search files and pairs" IsHitTestVisible="False"
                         Margin="9,0,0,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextMuted55Brush}" FontSize="13"
                         Visibility="{Binding HasSearch, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
              <Button Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right"
                      Margin="0,0,3,0" Width="22" Height="22" Padding="0" ToolTip="Clear search"
                      Click="OnClearSearch"
                      Visibility="{Binding HasSearch, Converter={StaticResource BoolToVisibility}}">
                <icons:Icon Key="X" Size="11" />
              </Button>
            </Grid>

            <Border Style="{StaticResource SegmentContainerStyle}">
              <StackPanel Orientation="Horizontal">
                <RadioButton GroupName="Range" Style="{StaticResource LabelledSegmentStyle}"
                             IsChecked="{Binding IsLast24Hours, Mode=OneWay}"
                             Click="OnRange24" Content="24 hours" />
                <Border Style="{StaticResource SegmentSeparatorStyle}" />
                <RadioButton GroupName="Range" Style="{StaticResource LabelledSegmentStyle}"
                             IsChecked="{Binding IsLast7Days, Mode=OneWay}"
                             Click="OnRange7" Content="7 days" />
                <Border Style="{StaticResource SegmentSeparatorStyle}" />
                <RadioButton GroupName="Range" Style="{StaticResource LabelledSegmentStyle}"
                             IsChecked="{Binding IsLast30Days, Mode=OneWay}"
                             Click="OnRange30" Content="30 days" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Column headings -->
          <Grid Grid.Row="2">
            <DockPanel>
              <Control DockPanel.Dock="Bottom" Template="{StaticResource FadingRowRuleTemplate}" />
              <!--
                Widths bind two-way to the shared ActivityColumns. A GridSplitter sets the
                ColumnDefinition's width directly, which travels back through the binding and
                moves every row with it. FILE stays star-sized so it absorbs the slack.
              -->
              <Grid Margin="0,0,0,5.6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{Binding Columns.TimeWidth, Mode=TwoWay}" MinWidth="60" />
                  <ColumnDefinition Width="{Binding Columns.EventWidth, Mode=TwoWay}" MinWidth="60" />
                  <ColumnDefinition Width="*" MinWidth="80" />
                  <ColumnDefinition Width="{Binding Columns.PairWidth, Mode=TwoWay}" MinWidth="60" />
                  <ColumnDefinition Width="{Binding Columns.ResultWidth, Mode=TwoWay}" MinWidth="60" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="TIME" Style="{StaticResource TableHeaderTextStyle}" />
                <TextBlock Grid.Column="1" Text="EVENT" Style="{StaticResource TableHeaderTextStyle}" />
                <TextBlock Grid.Column="2" Text="FILE" Style="{StaticResource TableHeaderTextStyle}" />
                <TextBlock Grid.Column="3" Text="FOLDER PAIR" Style="{StaticResource TableHeaderTextStyle}" />
                <TextBlock Grid.Column="4" Text="RESULT" Style="{StaticResource TableHeaderTextStyle}" />

                <GridSplitter Grid.Column="0" Style="{StaticResource ColumnSplitterStyle}" />
                <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitterStyle}" />
                <GridSplitter Grid.Column="2" Style="{StaticResource ColumnSplitterStyle}" />
                <GridSplitter Grid.Column="3" Style="{StaticResource ColumnSplitterStyle}" />
              </Grid>
            </DockPanel>
          </Grid>

          <!-- Rows -->
          <Grid Grid.Row="3">
            <ListBox x:Name="RowList" Style="{StaticResource ActivityListStyle}"
                     ItemsSource="{Binding Rows}" ScrollViewer.ScrollChanged="OnScrollChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ToolTip="{Binding Tooltip}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="{Binding Columns.TimeWidth}" />
                      <ColumnDefinition Width="{Binding Columns.EventWidth}" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="{Binding Columns.PairWidth}" />
                      <ColumnDefinition Width="{Binding Columns.ResultWidth}" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Time}"
                               Style="{StaticResource TabularTextStyle}" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <icons:Icon Key="{Binding EventIcon}" Size="14" Margin="0,0,6,0"
                                  Style="{StaticResource ActivityEventIconStyle}" />
                      <TextBlock Text="{Binding Event}" FontSize="13" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding File}" Margin="0,0,11.2,0"
                               Style="{StaticResource MonoTextStyle}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Column="3" Text="{Binding PairName}" Margin="0,0,11.2,0"
                               Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <ContentControl Grid.Column="4" Content="{Binding Result}"
                                    Style="{StaticResource ActivityResultTagStyle}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock VerticalAlignment="Top" Margin="0,16.8,0,0"
                       Style="{StaticResource SecondaryTextStyle}"
                       Text="Nothing logged in this window."
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
        </Grid>
      </DockPanel>
    </Border>

    <!--
      Resize grips. WindowStyle=None with AllowsTransparency leaves no non-client area, so Windows
      has no border to start a resize from and ResizeMode=CanResize on its own does nothing - the
      window simply would not resize. These strips sit on the card's edge and hand the drag back
      with WM_NCLBUTTONDOWN, so the actual resize is the system's: snapping, MinWidth/MinHeight and
      multi-monitor DPI all behave as they would on any other window.
    -->
    <Grid>
      <Rectangle Height="6" VerticalAlignment="Top" Margin="6,0" Fill="Transparent"
                 Cursor="SizeNS" Tag="Top" MouseLeftButtonDown="OnResizeGrip" />
      <Rectangle Height="6" VerticalAlignment="Bottom" Margin="6,0" Fill="Transparent"
                 Cursor="SizeNS" Tag="Bottom" MouseLeftButtonDown="OnResizeGrip" />
      <Rectangle Width="6" HorizontalAlignment="Left" Margin="0,6" Fill="Transparent"
                 Cursor="SizeWE" Tag="Left" MouseLeftButtonDown="OnResizeGrip" />
      <Rectangle Width="6" HorizontalAlignment="Right" Margin="0,6" Fill="Transparent"
                 Cursor="SizeWE" Tag="Right" MouseLeftButtonDown="OnResizeGrip" />

      <Rectangle Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Fill="Transparent" Cursor="SizeNWSE" Tag="TopLeft" MouseLeftButtonDown="OnResizeGrip" />
      <Rectangle Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Fill="Transparent" Cursor="SizeNESW" Tag="TopRight" MouseLeftButtonDown="OnResizeGrip" />
      <Rectangle Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Fill="Transparent" Cursor="SizeNESW" Tag="BottomLeft" MouseLeftButtonDown="OnResizeGrip" />
      <Rectangle Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Fill="Transparent" Cursor="SizeNWSE" Tag="BottomRight" MouseLeftButtonDown="OnResizeGrip" />
    </Grid>
  </Grid>
</Window>
