<Window x:Class="DBsync.Tray.Views.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:DBsync.Tray.Icons"
        xmlns:views="clr-namespace:DBsync.Tray.Views"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" ResizeMode="NoResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

  <!--
    Add / edit folder pair. 520px, own chrome, positioned clear of the flyout — the design is
    explicit that a window and the flyout must never overlap on open.
  -->

  <Window.Resources>
    <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>

  <Grid x:Name="Root" Width="520" Margin="24" RenderTransformOrigin="0.5,1">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="RiseTransform" Y="10" />
    </Grid.RenderTransform>

    <Border CornerRadius="{DynamicResource RadiusLg}"
            Background="{DynamicResource BackgroundBrush}"
            Effect="{DynamicResource ShadowLgEffect}" />

    <Border CornerRadius="{DynamicResource RadiusLg}" ClipToBounds="True"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource EdgeLgBrush}" BorderThickness="1">
      <StackPanel>

        <!-- ── Title bar ───────────────────────────────────────────────── -->
        <Border Style="{StaticResource WindowTitleBarStyle}" MouseLeftButtonDown="OnTitleBarDrag">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <icons:Icon Grid.Column="0" Key="ArrowsLeftRight" Size="16"
                        Foreground="{DynamicResource AccentBrush}" Margin="0,0,8.4,0" />
            <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource WindowTitleTextStyle}" />
            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="OnCancel" ToolTip="Close">
              <icons:Icon Key="X" Size="14" />
            </Button>
          </Grid>
        </Border>

        <!-- ── Step indicator ──────────────────────────────────────────── -->
        <ItemsControl ItemsSource="{Binding Steps}" Margin="22.4,16.8,22.4,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,5.6,0">
                <Border Style="{StaticResource StepBarStyle}" />
                <TextBlock Text="{Binding Label}" Style="{StaticResource StepLabelStyle}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ── Body ────────────────────────────────────────────────────── -->
        <Grid Margin="22.4,16.8,22.4,22.4">

          <!-- Step 1 — Which local folder? -->
          <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Which local folder?" Style="{StaticResource H4TextStyle}" Margin="0,0,0,11.2" />

            <TextBlock Text="Local path" Style="{StaticResource FieldLabelTextStyle}" />
            <Grid Margin="0,0,0,11.2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Style="{StaticResource InputStyle}" Margin="0,0,5.6,0"
                       Text="{Binding LocalPath, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                      Command="{Binding BrowseCommand}">
                <StackPanel Orientation="Horizontal">
                  <icons:Icon Key="FolderOpen" Size="14" Margin="0,0,6,0" />
                  <TextBlock Text="Browse" />
                </StackPanel>
              </Button>
            </Grid>

            <StackPanel Visibility="{Binding HasRecentFolders, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,0,0,11.2">
              <TextBlock Text="RECENT" Style="{StaticResource RecentKickerStyle}" Margin="0,0,0,5.6" />
              <ItemsControl ItemsSource="{Binding RecentFolders}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource RecentPathButtonStyle}" Content="{Binding}"
                            Click="OnPickRecent" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                       Text="Subfolders are included. DBsync watches this folder and syncs changes as they happen." />

            <!--
              Not in the design, which only draws a validation line on step 2. Without one here,
              a bad path makes Continue do nothing at all with no explanation.
            -->
            <StackPanel Orientation="Horizontal" Margin="0,8.4,0,0"
                        Visibility="{Binding HasValidation, Converter={StaticResource BoolToVisibility}}">
              <icons:Icon Key="{Binding ValidationIcon}" Size="14" Margin="0,1,6,0" VerticalAlignment="Top"
                          Foreground="{Binding Foreground, ElementName=LocalValidationText}" />
              <TextBlock x:Name="LocalValidationText" Text="{Binding ValidationMessage}"
                         Style="{StaticResource ValidationLineStyle}" MaxWidth="430" />
            </StackPanel>
          </StackPanel>

          <!-- Step 2 — Where on the network? -->
          <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Where on the network?" Style="{StaticResource H4TextStyle}" Margin="0,0,0,11.2" />

            <Border Style="{StaticResource SegmentContainerStyle}" HorizontalAlignment="Left"
                    Margin="0,0,0,11.2">
              <StackPanel Orientation="Horizontal">
                <RadioButton GroupName="Dest" Style="{StaticResource LabelledSegmentStyle}"
                             IsChecked="{Binding IsUnc, Mode=OneWay}" Command="{Binding PickUncCommand}">
                  <StackPanel Orientation="Horizontal">
                    <icons:Icon Key="Network" Size="14" Margin="0,0,6,0"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    <TextBlock Text="UNC path" />
                  </StackPanel>
                </RadioButton>
                <Border Style="{StaticResource SegmentSeparatorStyle}" />
                <RadioButton GroupName="Dest" Style="{StaticResource LabelledSegmentStyle}"
                             IsChecked="{Binding IsDrive, Mode=OneWay}" Command="{Binding PickDriveCommand}">
                  <StackPanel Orientation="Horizontal">
                    <icons:Icon Key="HardDrive" Size="14" Margin="0,0,6,0"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    <TextBlock Text="Mapped drive" />
                  </StackPanel>
                </RadioButton>
              </StackPanel>
            </Border>

            <TextBlock Text="{Binding DestLabel}" Style="{StaticResource FieldLabelTextStyle}" />
            <!--
              PropertyChanged, not LostFocus: the probe fires from LostFocus too, and the order
              of a binding's own update against a handler for the same event is not defined —
              committing on blur meant probing the value the user had just replaced.
            -->
            <TextBox Style="{StaticResource MonoInputStyle}" Margin="0,0,0,11.2"
                     Text="{Binding SharePath, UpdateSourceTrigger=PropertyChanged}"
                     LostFocus="OnDestinationBlur" />

            <!-- UNC only: credentials, filed in Credential Manager rather than config.json -->
            <Border Style="{StaticResource SurfacePanelStyle}" Margin="0,0,0,11.2"
                    Visibility="{Binding IsUnc, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <Grid Margin="0,0,0,8.4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,4.2,0">
                    <TextBlock Text="Username" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Style="{StaticResource InputStyle}"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="4.2,0,0,0">
                    <TextBlock Text="Password" Style="{StaticResource FieldLabelTextStyle}" />
                    <!--
                      PasswordBox has no bindable Password property by design; the code-behind
                      pushes it to the view model so it never sits in a binding's value store.
                    -->
                    <PasswordBox x:Name="PasswordField" Style="{StaticResource PasswordInputStyle}"
                                 PasswordChanged="OnPasswordChanged" />
                  </StackPanel>
                </Grid>
                <CheckBox Style="{StaticResource CheckBoxStyle}" IsChecked="{Binding SaveCredentials}"
                          Content="Store credentials in Windows Credential Manager" />
              </StackPanel>
            </Border>

            <!-- The service's own validation copy, rendered verbatim -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding HasValidation, Converter={StaticResource BoolToVisibility}}">
              <icons:Icon Key="{Binding ValidationIcon}" Size="14" Margin="0,1,6,0" VerticalAlignment="Top"
                          Foreground="{Binding Foreground, ElementName=ProbeText}" />
              <TextBlock x:Name="ProbeText" Text="{Binding ValidationMessage}"
                         Style="{StaticResource ValidationLineStyle}" MaxWidth="430" />
            </StackPanel>
          </StackPanel>

          <!-- Step 3 — How should it sync? -->
          <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="How should it sync?" Style="{StaticResource H4TextStyle}" Margin="0,0,0,11.2" />

            <StackPanel Margin="0,0,0,11.2">
              <RadioButton GroupName="Direction" Style="{StaticResource RadioStyle}" Margin="0,0,0,8.4"
                           IsChecked="{Binding IsTwoWay}">
                <StackPanel>
                  <TextBlock Text="Two-way sync" />
                  <TextBlock Text="Changes flow in both directions" Style="{StaticResource DirectionHintStyle}" />
                </StackPanel>
              </RadioButton>
              <RadioButton GroupName="Direction" Style="{StaticResource RadioStyle}" Margin="0,0,0,8.4"
                           IsChecked="{Binding IsPush}">
                <StackPanel>
                  <TextBlock Text="One-way push" />
                  <TextBlock Text="Local wins; the share mirrors this PC" Style="{StaticResource DirectionHintStyle}" />
                </StackPanel>
              </RadioButton>
              <RadioButton GroupName="Direction" Style="{StaticResource RadioStyle}"
                           IsChecked="{Binding IsPull}">
                <StackPanel>
                  <TextBlock Text="One-way pull" />
                  <TextBlock Text="Share wins; this PC mirrors it" Style="{StaticResource DirectionHintStyle}" />
                </StackPanel>
              </RadioButton>
            </StackPanel>

            <Border Style="{StaticResource SurfacePanelStyle}" Margin="0,0,0,11.2">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="Realtime watcher" Style="{StaticResource LabelTextStyle}" />
                  <TextBlock Text="Sync the moment a file changes" Style="{StaticResource DirectionHintStyle}" />
                </StackPanel>
                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchStyle}"
                              IsChecked="{Binding Watcher}" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Button Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left"
                    Command="{Binding ToggleAdvancedCommand}" Margin="0,0,0,8.4">
              <StackPanel Orientation="Horizontal">
                <icons:Icon Key="{Binding AdvancedChevron}" Size="14" Margin="0,0,6,0"
                            Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="Advanced options" />
              </StackPanel>
            </Button>

            <Border Style="{StaticResource SurfacePanelStyle}"
                    Visibility="{Binding AdvancedOpen, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <TextBlock Text="Exclude patterns" Style="{StaticResource FieldLabelTextStyle}" />
                <TextBox Style="{StaticResource MonoInputStyle}" Margin="0,0,0,8.4"
                         Text="{Binding Excludes, UpdateSourceTrigger=PropertyChanged}" />
                <Grid Margin="0,0,0,8.4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,4.2,0">
                    <TextBlock Text="Upload limit" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Style="{StaticResource InputStyle}"
                             Text="{Binding UploadLimit, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="4.2,0,0,0">
                    <TextBlock Text="Keep file versions" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Style="{StaticResource InputStyle}"
                             Text="{Binding VersionsKept, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>
                <CheckBox Style="{StaticResource CheckBoxStyle}" IsChecked="{Binding UseVss}"
                          Content="Copy locked files via volume shadow copy" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <!-- ── Footer ──────────────────────────────────────────────────── -->
        <Grid Margin="22.4,0,22.4,22.4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="{Binding Summary}" Style="{StaticResource WizardSummaryStyle}"
                     Margin="0,0,11.2,0" />
          <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,5.6,0"
                  Content="{Binding BackLabel}" Command="{Binding BackCommand}" />
          <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                  Content="{Binding NextLabel}" Command="{Binding NextCommand}" IsDefault="True" />
        </Grid>

      </StackPanel>
    </Border>
  </Grid>
</Window>
