<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- For NotifyIcon only. WPF has no tray-icon primitive of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DBsync.Tray</AssemblyName>
    <RootNamespace>DBsync.Tray</RootNamespace>
    <Version>1.0.0</Version>
    <Product>DBsync</Product>
    <Description>DBsync tray application.</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Inter ships with the app rather than being pulled from Google Fonts. Drop the .ttf files
      into Assets/Fonts and they are picked up automatically; until then the FontFamily
      resources fall back to an installed Inter, then to Segoe UI. See Themes/Typography.xaml.
    -->
    <Resource Include="Assets\Fonts\**\*.ttf" />
    <Resource Include="Assets\Fonts\**\*.otf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DBsync.Contracts\DBsync.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      UseWindowsForms adds these to the implicit usings, where they collide with WPF on
      Application, Icon, FontFamily and more. This app is WPF; the two files that genuinely need
      WinForms or GDI+ import them explicitly, under an alias.
    -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

</Project>

