<!--
  Composite styles for the tray flyout. Status-dependent colour lives in DataTriggers rather than
  the view model, so every value stays a DynamicResource and follows an appearance change.

  Status → icon colour / tag / left edge is the table in docs/README.md §1, with the exact colour
  roles taken from statusOf() in docs/DBsync.dc.html.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <sys:Double x:Key="PairIconSize">15</sys:Double>
  <sys:Double x:Key="PathArrowSize">12</sys:Double>
  <sys:Double x:Key="HeaderGlyphSize">18</sys:Double>
  <sys:Double x:Key="HeaderButtonGlyphSize">15</sys:Double>
  <sys:Double x:Key="LocalPathMaxWidth">130</sys:Double>
  <sys:Double x:Key="SharePathMaxWidth">160</sys:Double>

  <!-- ── Header status line ───────────────────────────────────────────────
       Three states, each with its own colour: calm neutral-400 when everything is in sync, the
       accent when something needs attention, and muted while paused.
  -->
  <Style x:Key="StatusLineStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,1,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource CalmTextBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      </DataTrigger>
      <!-- Paused wins: it describes the whole app, whatever individual rows say. -->
      <DataTrigger Binding="{Binding PausedAll}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted55Brush}" />
      </DataTrigger>
      <!-- Disconnected wins over everything: the app knows nothing about sync state. -->
      <DataTrigger Binding="{Binding IsConnected}" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted55Brush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ── Pair row ─────────────────────────────────────────────────────────
       A full-width button: the whole row is the click target, per the design.
  -->
  <Style x:Key="PairRowStyle" TargetType="Button">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="16,11,16,11" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeQuietBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Stretch" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RowHoverTintBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Status}" Value="Syncing">
        <Setter Property="BorderBrush" Value="{DynamicResource EdgeSyncingBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="Conflict">
        <Setter Property="BorderBrush" Value="{DynamicResource EdgeConflictBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Line 1's glyph. In sync is the calm neutral-400; only Conflict takes the full accent. -->
  <Style x:Key="PairStatusIconStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource CalmTextBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Status}" Value="Syncing">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="Conflict">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="Waiting">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted55Brush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="Paused">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted55Brush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!--
    One tag that restyles itself, rather than three that take turns being visible. Style cannot
    be set from a trigger, so the individual brushes are.
  -->
  <Style x:Key="PairTagStyle" TargetType="ContentControl" BasedOn="{StaticResource BaseTagStyle}">
    <Setter Property="Background" Value="{DynamicResource TagNeutralBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TagNeutralForegroundBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Status}" Value="Syncing">
        <Setter Property="Background" Value="{DynamicResource TagAccentBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TagAccentForegroundBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="Conflict">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ── Appearance segmented control ─────────────────────────────────────
       Icon-only options. ToolTip carries the accessible label, matching the prototype's
       title attribute.
  -->
  <Style x:Key="SegmentOptionStyle" TargetType="RadioButton">
    <Setter Property="Padding" Value="9,6,9,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <!-- The selected option is an inset accent outline, not a fill. -->
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
              <Setter TargetName="Chrome" Property="Padding" Value="8,5,8,5" />
              <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="False" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverTintBrush}" />
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
              <Setter TargetName="Chrome" Property="Padding" Value="8,5,8,5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The segment container: one rounded outline, hairline separators between options. -->
  <Style x:Key="SegmentContainerStyle" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="SegmentSeparatorStyle" TargetType="Border">
    <Setter Property="Width" Value="1" />
    <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
  </Style>

  <!-- ── Tray context menu ────────────────────────────────────────────────
       Open / Pause / Quit, per the design's note on right-clicking the tray icon. Themed rather
       than left as a system menu so it does not read as a different application.
  -->
  <Style x:Key="TrayMenuItemStyle" TargetType="MenuItem">
    <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Padding" Value="11.2,6,11.2,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}"
                  CornerRadius="{DynamicResource RadiusSm}" SnapsToDevicePixels="True">
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverTintBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TrayContextMenuStyle" TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeMdBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="5.6" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource TrayMenuItemStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource RadiusMd}"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <StackPanel IsItemsHost="True" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Resources>
      <Style TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="5.6,2.8,5.6,2.8" />
        <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Separator">
              <Border Height="1" Background="{DynamicResource DividerBrush}" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Style.Resources>
  </Style>

  <!-- ── Progress (line 4) ────────────────────────────────────────────────
       3px track, accent fill at the pair's percentage, and a highlight sweeping across it. The
       sweep is animated on the brush's RelativeTransform, so it works in the brush's own 0–1
       space and needs no knowledge of the track's pixel width.
  -->
  <Style x:Key="ProgressSweepStyle" TargetType="Rectangle">
    <Setter Property="Fill" Value="{DynamicResource ProgressSweepBrush}" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="RenderTransform">
      <Setter.Value>
        <TranslateTransform />
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <EventTrigger RoutedEvent="Loaded">
        <BeginStoryboard>
          <Storyboard>
            <!--
              The highlight is 30% of the track and travels from translateX(-100%) to
              translateX(280%) of its own width — so in track space, from -0.3 to 0.84.
            -->
            <DoubleAnimation Storyboard.TargetProperty="(Rectangle.Fill).(Brush.RelativeTransform).(TranslateTransform.X)"
                             From="-0.3" To="0.84" Duration="0:0:1.6" RepeatBehavior="Forever" />
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
