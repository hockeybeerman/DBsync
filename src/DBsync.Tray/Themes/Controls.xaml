<!--
  Component styles, built from the role tokens. Nothing here hard-codes a colour: every brush is
  a DynamicResource, which is what makes a theme swap repaint live.

  These are the shared primitives from docs/styles.css. Composite surfaces (pair rows, the step
  indicator, toasts) belong with the issues that build them.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ── Focus ────────────────────────────────────────────────────────────
       "Focus: 2px solid #9184d9, offset 2px — never the browser default."
       WPF only paints FocusVisualStyle for keyboard focus, which is the behaviour
       :focus-visible describes.
  -->
  <Style x:Key="AccentFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-2" StrokeThickness="2" RadiusX="10" RadiusY="10"
                     Stroke="{DynamicResource AccentBrush}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Buttons — outlined, never filled ─────────────────────────────── -->
  <Style x:Key="BaseButtonStyle" TargetType="Button">
    <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
    <Setter Property="FontWeight" Value="{DynamicResource HeadingFontWeight}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource RadiusMd}"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentHoverTintBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentPressedTintBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource HoverTintBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource PressedTintBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Padding" Value="{DynamicResource GhostButtonPadding}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentGhostHoverTintBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentGhostPressedTintBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- 30x30 in every window chrome the design draws (the base sheet's 36px is the deck size). -->
  <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
    <Setter Property="Width" Value="{DynamicResource IconButtonSize}" />
    <Setter Property="Height" Value="{DynamicResource IconButtonSize}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- ── Input ────────────────────────────────────────────────────────── -->
  <Style x:Key="InputStyle" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentSelectionBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource InputMinHeight}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource RadiusMd}"
                  SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center" Focusable="False"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush"
                      Value="{DynamicResource InputHoverBorderBrush}" />
            </Trigger>
            <!-- The input takes the accent on its own border rather than an offset ring. -->
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="MonoInputStyle" TargetType="TextBox" BasedOn="{StaticResource InputStyle}">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
  </Style>

  <!-- ── Tags ─────────────────────────────────────────────────────────── -->
  <Style x:Key="BaseTagStyle" TargetType="ContentControl">
    <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeMeta}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{DynamicResource TagPadding}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource RadiusTag}"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <TextBlock Text="{TemplateBinding Content}"
                       Foreground="{TemplateBinding Foreground}"
                       FontSize="{TemplateBinding FontSize}"
                       FontFamily="{TemplateBinding FontFamily}"
                       VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TagNeutralStyle" TargetType="ContentControl" BasedOn="{StaticResource BaseTagStyle}">
    <Setter Property="Background" Value="{DynamicResource TagNeutralBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TagNeutralForegroundBrush}" />
  </Style>

  <Style x:Key="TagAccentStyle" TargetType="ContentControl" BasedOn="{StaticResource BaseTagStyle}">
    <Setter Property="Background" Value="{DynamicResource TagAccentBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TagAccentForegroundBrush}" />
  </Style>

  <Style x:Key="TagOutlineStyle" TargetType="ContentControl" BasedOn="{StaticResource BaseTagStyle}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- ── Elevation ────────────────────────────────────────────────────────
       Each level is a hairline border plus, from md up, a drop shadow — the two halves CSS
       packs into one box-shadow.
  -->
  <Style x:Key="ElevationSmStyle" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeSmBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
  </Style>

  <Style x:Key="ElevationMdStyle" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeMdBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Effect" Value="{DynamicResource ShadowMdEffect}" />
  </Style>

  <Style x:Key="ElevationLgStyle" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeLgBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
    <Setter Property="Effect" Value="{DynamicResource ShadowLgEffect}" />
  </Style>

  <!-- ── Card ─────────────────────────────────────────────────────────── -->
  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
  </Style>

  <!-- ── Rule ─────────────────────────────────────────────────────────────
       The Nocturne signature: fades to transparent 48px from each end. A gradient cannot
       express "48px from both ends" at an unknown width, so the rule is three strips — fade in,
       solid, fade out — which is exact at any width.
  -->
  <Style x:Key="FadingRuleStyle" TargetType="Separator">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,11.2,0,11.2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Grid Height="1" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="48" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>
            <!--
              The fade is an OpacityMask rather than a gradient of the divider colour, so the
              strips keep reading the live DividerBrush and follow a theme swap.
            -->
            <Rectangle Grid.Column="0" Fill="{DynamicResource DividerBrush}">
              <Rectangle.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Offset="0" Color="#00000000" />
                  <GradientStop Offset="1" Color="#FF000000" />
                </LinearGradientBrush>
              </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Column="1" Fill="{DynamicResource DividerBrush}" />
            <Rectangle Grid.Column="2" Fill="{DynamicResource DividerBrush}">
              <Rectangle.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Offset="0" Color="#FF000000" />
                  <GradientStop Offset="1" Color="#00000000" />
                </LinearGradientBrush>
              </Rectangle.OpacityMask>
            </Rectangle>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Switch (realtime watcher) ────────────────────────────────────── -->
  <Style x:Key="SwitchStyle" TargetType="ToggleButton">
    <Setter Property="Width" Value="{DynamicResource SwitchWidth}" />
    <Setter Property="Height" Value="{DynamicResource SwitchHeight}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Track" CornerRadius="{DynamicResource RadiusPill}" BorderThickness="1"
                  Background="Transparent"
                  BorderBrush="{DynamicResource DividerBrush}"
                  Padding="2" SnapsToDevicePixels="True">
            <!--
              The OFF knob is neutral-600 outright, not the neutral-400 role: the design names
              the ramp step, so it holds the same value in both modes.
            -->
            <Ellipse x:Name="Knob" Width="{DynamicResource SwitchKnobSize}"
                     Height="{DynamicResource SwitchKnobSize}"
                     HorizontalAlignment="Left"
                     Fill="{DynamicResource Neutral600Brush}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource SwitchOnTrackBrush}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentEmphasisBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Radio ────────────────────────────────────────────────────────── -->
  <Style x:Key="RadioStyle" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <StackPanel Orientation="Horizontal">
            <!--
              Checked state is an accent ring, a band of the ground, then a small accent disc —
              the CSS is a filled circle with a 4px inset shadow in the background colour, which
              works out to a 5px centre on a 16px dot.
            -->
            <Grid Width="{DynamicResource RadioDotSize}" Height="{DynamicResource RadioDotSize}"
                  VerticalAlignment="Top" Margin="0,3,8,0">
              <Border x:Name="Dot"
                      CornerRadius="{DynamicResource RadiusPill}"
                      BorderThickness="1.5"
                      BorderBrush="{DynamicResource DividerBrush}"
                      Background="Transparent"
                      SnapsToDevicePixels="True" />
              <Ellipse x:Name="Centre" Width="5" Height="5" Visibility="Collapsed"
                       Fill="{DynamicResource AccentBrush}" />
            </Grid>
            <ContentPresenter VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Centre" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
