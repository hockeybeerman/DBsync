<!--
  Activity table, plus the dropdown the filters need.

  The Nocturne rule signature applies to table rows: each row's underline fades to transparent 48px
  from each end, so the rules read as part of the page rather than as a grid.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!--
    Column widths, straight from the design. Header and rows share them, which is the point of
    hoisting them out.

    GridLength, not Double: ColumnDefinition.Width is a GridLength, and a DynamicResource does not
    run a type converter on the way in — a Double here throws an InvalidCastException at load.
  -->
  <!--
    Splitter sitting on a column's trailing edge. Transparent and 6px wide so it is grabbable
    without drawing a line the design never asked for; the cursor is the only affordance.
  -->
  <Style x:Key="ColumnSplitterStyle" TargetType="GridSplitter">
    <Setter Property="Width" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ResizeBehavior" Value="CurrentAndNext" />
    <Setter Property="ResizeDirection" Value="Columns" />
    <Setter Property="Margin" Value="0,-4,0,-4" />
    <Setter Property="Cursor" Value="SizeWE" />
    <Setter Property="Focusable" Value="False" />
  </Style>

  <GridLength x:Key="ActivityTimeWidth">132</GridLength>
  <GridLength x:Key="ActivityEventWidth">110</GridLength>
  <GridLength x:Key="ActivityPairWidth">150</GridLength>
  <GridLength x:Key="ActivityResultWidth">96</GridLength>

  <!-- ── Fading row rule ──────────────────────────────────────────────────
       Three strips rather than a gradient: a gradient cannot express "48px from both ends" at an
       unknown width. The header uses the divider; body rows use a lighter 8% text.
  -->
  <ControlTemplate x:Key="FadingRowRuleTemplate">
    <Grid Height="1" SnapsToDevicePixels="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="48" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="48" />
      </Grid.ColumnDefinitions>
      <Rectangle Grid.Column="0" Fill="{DynamicResource TableRuleBrush}">
        <Rectangle.OpacityMask>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#00000000" />
            <GradientStop Offset="1" Color="#FF000000" />
          </LinearGradientBrush>
        </Rectangle.OpacityMask>
      </Rectangle>
      <Rectangle Grid.Column="1" Fill="{DynamicResource TableRuleBrush}" />
      <Rectangle Grid.Column="2" Fill="{DynamicResource TableRuleBrush}">
        <Rectangle.OpacityMask>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#FF000000" />
            <GradientStop Offset="1" Color="#00000000" />
          </LinearGradientBrush>
        </Rectangle.OpacityMask>
      </Rectangle>
    </Grid>
  </ControlTemplate>

  <!-- ── Rows ─────────────────────────────────────────────────────────────
       ListBoxItem rather than a bare ItemsControl so the list virtualises and keyboard
       navigation works; the chrome is stripped back to a hover tint and the rule.
  -->
  <Style x:Key="ActivityRowStyle" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Chrome" Background="Transparent" SnapsToDevicePixels="True">
            <DockPanel>
              <Control DockPanel.Dock="Bottom" Template="{StaticResource FadingRowRuleTemplate}" />
              <ContentPresenter Margin="0,5.6,0,5.6" />
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background"
                      Value="{DynamicResource TableRowHoverTintBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background"
                      Value="{DynamicResource RowHoverTintBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Virtualised and recycling: the log holds a month of history, and the design asks for 10k+
    rows to scroll without jank. Pixel scroll units keep the fading rules from stepping.
  -->
  <Style x:Key="ActivityListStyle" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource ActivityRowStyle}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
  </Style>

  <!-- ── Event glyph colour, by kind ──────────────────────────────────────
       Sent takes accent-300, Received neutral-300, Conflict the accent itself; the rest stay
       muted. Straight from the design's event table.
  -->
  <Style x:Key="ActivityEventIconStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted55Brush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Entry.Kind}" Value="Sent">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Entry.Kind}" Value="Received">
        <Setter Property="Foreground" Value="{DynamicResource EventReceivedBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Entry.Kind}" Value="Conflict">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Pending and Failed are the states worth chasing, so they take the outlined tag. -->
  <Style x:Key="ActivityResultTagStyle" TargetType="ContentControl"
         BasedOn="{StaticResource BaseTagStyle}">
    <Setter Property="Background" Value="{DynamicResource TagNeutralBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TagNeutralForegroundBrush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding ResultNeedsAttention}" Value="True">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ── Dropdown ─────────────────────────────────────────────────────────
       Not in the design, which shows no filters — built from the input and menu treatments so it
       reads as part of the same family.
  -->
  <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeChrome}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,5,6,5" />
    <Setter Property="MinWidth" Value="150" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ComboBoxItem">
          <Setter Property="Padding" Value="10,6,10,6" />
          <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="Chrome" Background="Transparent"
                        Padding="{TemplateBinding Padding}"
                        CornerRadius="{DynamicResource RadiusSm}">
                  <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Chrome" Property="Background"
                            Value="{DynamicResource HoverTintBrush}" />
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="PART_Toggle" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                      RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Chrome" Background="{DynamicResource SurfaceBrush}"
                          BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                          CornerRadius="{DynamicResource RadiusMd}" SnapsToDevicePixels="True" />
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Chrome" Property="BorderBrush"
                              Value="{DynamicResource InputHoverBorderBrush}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Chrome" Property="BorderBrush"
                              Value="{DynamicResource AccentBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>

            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                              HorizontalAlignment="Left" IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

            <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource TextMuted55Brush}"
                  StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,10,0" IsHitTestVisible="False" />

            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                   AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
              <Border Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource EdgeMdBrush}" BorderThickness="1"
                      CornerRadius="{DynamicResource RadiusMd}" Padding="5.6" Margin="0,4,0,0"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                  <StackPanel IsItemsHost="True" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
