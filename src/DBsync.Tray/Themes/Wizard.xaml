<!--
  Styles for the add/edit pair wizard and the window chrome the other surfaces will share.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:text="clr-namespace:DBsync.Tray.Text">

  <!-- ── Window chrome ────────────────────────────────────────────────────
       The design draws its own title bar on the surface colour, so every window is
       WindowStyle=None with this strip at the top.
  -->
  <Style x:Key="WindowTitleBarStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Padding" Value="11.2,8.4,11.2,8.4" />
  </Style>

  <Style x:Key="WindowTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
    <Setter Property="FontWeight" Value="{DynamicResource HeadingFontWeight}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeChrome}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ── Step indicator ───────────────────────────────────────────────────
       Three equal columns, each a 2px bar over an 11px label. Completed and current steps
       share a treatment; only upcoming ones are dimmed.
  -->
  <Style x:Key="StepBarStyle" TargetType="Border">
    <Setter Property="Height" Value="2" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource StepBarInactiveBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Active}" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="StepLabelStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeMeta}" />
    <Setter Property="Margin" Value="0,6,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted55Brush}" />
    <Setter Property="text:Tracking.Amount" Value="0.04" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Active}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ── Surface panel ────────────────────────────────────────────────────
       The credential block and the advanced-options block share this treatment.
  -->
  <Style x:Key="SurfacePanelStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="11.2" />
  </Style>

  <!-- ── Segmented control with a label ───────────────────────────────────
       The flyout's Appearance control is icon-only; this one carries icon plus text.
  -->
  <Style x:Key="LabelledSegmentStyle" TargetType="RadioButton"
         BasedOn="{StaticResource SegmentOptionStyle}">
    <Setter Property="Padding" Value="12,7,12,7" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeChrome}" />
    <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
  </Style>

  <!-- ── Validation line ──────────────────────────────────────────────────
       Success takes the accent-300 step; failure takes the accent itself, which is how the
       design distinguishes them without introducing a red the palette does not have.
  -->
  <Style x:Key="ValidationLineStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding ValidationOk}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
      </DataTrigger>
      <!-- Pending is neither pass nor fail, so it drops back to muted until the answer lands. -->
      <DataTrigger Binding="{Binding Checking}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted55Brush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Radio option with a hint beneath it, used for the three sync directions. -->
  <Style x:Key="DirectionHintStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSecondary}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted55Brush}" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>

  <!-- The RECENT kicker over the MRU buttons. -->
  <Style x:Key="RecentKickerStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeMeta}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted55Brush}" />
    <Setter Property="text:Tracking.Amount" Value="0.06" />
  </Style>

  <Style x:Key="RecentPathButtonStyle" TargetType="Button"
         BasedOn="{StaticResource SecondaryButtonStyle}">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSecondary}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Margin" Value="0,0,5.6,5.6" />
  </Style>

  <!-- The footer's path summary: monospace, muted, and first to give up its width. -->
  <Style x:Key="WizardSummaryStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSecondary}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted55Brush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</ResourceDictionary>
