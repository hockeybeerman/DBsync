<Application x:Class="DBsync.Tray.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!--
          Mode-independent layers. The role-token dictionary (Theme.Dark.xaml / Theme.Light.xaml)
          is NOT listed here — ThemeManager appends it at startup and swaps it in place, which is
          what makes a theme change a single dictionary write.
        -->
        <ResourceDictionary Source="Themes/Ramps.xaml" />
        <ResourceDictionary Source="Themes/Metrics.xaml" />
        <ResourceDictionary Source="Themes/Typography.xaml" />
        <ResourceDictionary Source="Themes/Controls.xaml" />
        <ResourceDictionary Source="Themes/Flyout.xaml" />
        <ResourceDictionary Source="Themes/Wizard.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
